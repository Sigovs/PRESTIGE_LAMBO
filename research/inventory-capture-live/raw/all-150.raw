olorIcon\":null,\"upholstery\":\"\",\"interiorColorGeneric\":null,\"exteriorColor\":\"Arctic White\",\"exteriorColorCode\":\"F2F6F9\",\"exteriorColorHex\":null,\"exteriorColorIcon\":null,\"exteriorColorGeneric\":null,\"fuelType\":\"\",\"wheelbaseCode\":\"\",\"vehicleId\":146872192,\"isSpecial\":0,\"specialDisclaimer\":\"\",\"daysInStock\":83,\"dateInStock\":{\"date\":\"2026-07-09 00:00:00.000000\",\"timezone_type\":3,\"timezone\":\"UTC\"},\"description\":\"Prestige Imports is delighted to offer this 2020 Rolls-Royce Wraith for sale! <br\\\/><br\\\/>A masterpiece of grand touring luxury, the Wraith effortlessly combines handcrafted British elegance with effortless V12 performance, creating one of the most distinguished coupes ever built. Powered by a 6.6L twin-turbocharged V12 producing 624 horsepower and 605 lb-ft of torque, the Wraith delivers seamless acceleration with remarkable refinement, reaching 0&ndash;60 mph in approximately 4.4 seconds while maintaining the serene composure expected of a Rolls-Royce. Its sweeping fastback silhouette, signature Pantheon grille, rear-hinged coach doors, and commanding proportions create an unmistakable presence whether arriving at a five-star resort, exclusive gala, or private aviation terminal. Inside, the meticulously handcrafted cabin surrounds occupants with the finest leather, rich wood veneers, polished metal accents, and cutting-edge technology, delivering an atmosphere of unparalleled comfort and sophistication. Perfect for discerning buyers seeking effortless performance, timeless design, and the exclusivity that only Rolls-Royce can provide, the Wraith remains one of the world's most extraordinary luxury grand tourers. <br\\\/><br\\\/>Contact Prestige Imports to make this Rolls-Royce Wraith yours today. Sales Price includes dealer fee of $1447.50 and $299 electronic filing fee. Tax, tag, title and registrations fees are not included and are calculated at time of purchase.\",\"isOEMCertified\":0,\"isDealerCertified\":0,\"body\":\"\",\"standardBody\":null,\"bodyStyle\":\"\",\"epaHighway\":18,\"epaCity\":12,\"drivetrain\":\"Rear Wheel Drive\",\"hasWarranty\":0,\"isSold\":0,\"dealerId\":7006,\"dealerCity\":\"North Miami Beach\",\"dealerState\":\"FL\",\"location\":\"North Miami Beach, FL\",\"dealerName\":\"Lamborghini Miami\",\"seoUrl\":\"vehicle-details\\\/used-2020-rolls-royce-wraith---north-miami-beach-fl-id-65565393\",\"mainImageUrl\":\"\\\/\\\/cdn-ds.com\\\/stock\\\/2020-Rolls-Royce-Wraith---North-Miami-Beach-FL\\\/seo\\\/ICC80512-SCAXZ0C08LUX87400\\\/sz_110125\\\/5b43ed9491c57fdeabc8154720c7d4ad.jpg\",\"photoCount\":46,\"series\":\"\",\"xSeries\":\"\",\"seriesCode\":\"\",\"cab\":\"\",\"bed\":\"\",\"videoCount\":0,\"comment1\":\"Adaptive Cruise Control,Backup Camera,Brake Assist,Head-Up Display,Heated Seats,Keyless Entry,Lane Departure Warning,Leather Seats,Memory Seat,Navigation System,Night Vision,Stability Control,Traction Control,Turbocharged\",\"comment2\":\"\",\"comment3\":\"\",\"comment4\":\"\",\"comment5\":\"\",\"otherInfo\":{\"isVinDecodeEnabled\":true},\"dealerComment\":\"\",\"videos\":[],\"images\":{},\"viewCount\":0,\"carfaxReport\":{\"image\":\"https:\\\/\\\/partnerstatic.carfax.com\\\/img\\\/valuebadge\\\/1own_great.svg\",\"link\":\"https:\\\/\\\/www.carfax.com\\\/vehiclehistory\\\/ar20\\\/akN8L_n3anjbQfU17zmhOhaWW5k7qZvLIwL3dIXb7wfoqwsUrmA_rCzEyd1q6bX4pm4Qn4KOcpt36q7kW9u0Z-UZA0671lBIwiA\",\"isOneOwner\":true},\"isInTransit\":0,\"certifiedInspectionUrl\":null,\"standardizedExteriorColor\":\"White\",\"standardizedBody\":\"Unspecified\\\/Other\",\"standardizedDrivetrain\":\"Rear-Wheel Drive\",\"standardizedEngineDisplacement\":\"6.6\",\"standardizedEngineCylinders\":\"Unspecified\\\/Other\",\"standardizedTransmission\":\"Automatic\",\"standardizedFuelType\":\"Unspecified\\\/Other\",\"standardizedInteriorColor\":\"Unspecified\\\/Other\",\"standardizedInteriorUpholstery\":\"Unspecified\\\/Other\",\"upperLevelPackageCode\":null,\"packagesAndAccessories\":[],\"certificationProgram\":\"\",\"title\":\"2020 Rolls-Royce Wraith .\",\"status\":\"in stock\",\"rebateAmount\":0,\"isReserved\":0,\"isCourtesy\":0,\"statusCode\":null,\"disclaimers\":[],\"isPooled\":0,\"cpo_validated\":null,\"vdp\":\"https:\\\/\\\/www.lamborghinimiami.com\\\/vehicle-details\\\/used-2020-rolls-royce-wraith---north-miami-beach-fl-id-65565393\",\"srp\":\"https:\\\/\\\/www.lamborghinimiami.com\\\/used-2020-rolls-royce-wraith-miami-fl\"}); });<\/script>\n<script>window.inlineJS.push(function() { Moff.modules.get('DataLayer').pushData('VehicleObject_65669926', {\"vuid\":65669926,\"stockNumber\":\"CD2527\",\"year\":1965,\"isNew\":false,\"finalPrice\":351697,\"make\":\"Shelby\",\"model\":\"Cobra\",\"modelNumber\":\"\",\"modelCode\":0,\"trim\":\"427 R 1 of 2 R-Specification CSX4000-Series\",\"styleDescription\":\"\",\"styleId\":0,\"doorsNumber\":\"2\",\"vin\":\"000000000CSX4007R\",\"MSRP\":0,\"invoiceAmount\":0,\"blueBook\":0,\"sellingPrice\":349950,\"internetPrice\":0,\"originalPrice\":349950,\"miscPrice1\":0,\"miscPrice2\":0,\"miscPrice3\":0,\"NADARetailPrice\":0,\"mileage\":4513,\"transmission\":\"manual\",\"transmissionDescription\":\"\",\"transmissionSpeedNumber\":\"\",\"engineCylindersNumber\":\"\",\"engineDisplacement\":\"\",\"engineDescription\":\"\",\"engineAspirationType\":\"\",\"engineBlockType\":\"\",\"interiorColor\":\"Black\",\"interiorColorCode\":\"252627\",\"interiorColorHex\":null,\"interiorColorIcon\":null,\"upholstery\":\"\",\"interiorColorGeneric\":null,\"exteriorColor\":\"Bright Blue\",\"exteriorColorCode\":\"009BD8\",\"exteriorColorHex\":null,\"exteriorColorIcon\":null,\"exteriorColorGeneric\":null,\"fuelType\":\"\",\"wheelbaseCode\":\"\",\"vehicleId\":147027899,\"isSpecial\":0,\"specialDisclaimer\":\"\",\"daysInStock\":69,\"dateInStock\":{\"date\":\"2026-07-23 00:00:00.000000\",\"timezone_type\":3,\"timezone\":\"UTC\"},\"description\":\"**EXCEPTIONALLY RARE 1965 SHELBY COBRA 427 R-SPECIFICATION &ndash; ONE OF ONLY TWO EVER BUILT**<br\\\/><br\\\/>Prestige Imports is honored to present an automotive legend of unparalleled rarity: a 1965 Shelby Cobra 427 R-Specification from the exclusive CSX4000-Series. This is not merely a Cobra &ndash; this is one of only two R-Specification examples in existence, making it among the most coveted and collectible Shelby vehicles on the planet.<br\\\/><br\\\/>**THE ULTIMATE COBRA EXPERIENCE**<br\\\/><br\\\/>Finished in stunning Bright Blue with a purposeful Black interior, this extraordinary machine embodies the raw, uncompromising spirit that made Carroll Shelby's creations legendary. The R-Specification designation represents the pinnacle of Cobra performance engineering, built for those who demanded absolute supremacy on both road and track. With just 4,513 miles showing, this Cobra remains in exceptional condition, ready to deliver the visceral driving experience that has captivated enthusiasts for generations.<br\\\/><br\\\/>**UNMISTAKABLE PRESENCE**<br\\\/><br\\\/>The Bright Blue exterior paint creates a striking contrast against the aggressive curves and muscular haunches that define the Cobra's iconic silhouette. Every angle reveals the purposeful design that prioritized function over form, yet somehow achieved both. The side-exit exhaust, competition-style fuel filler, and authentic Shelby badging announce this car's pedigree before the engine ever fires.<br\\\/><br\\\/>**PURE DRIVING ENGAGEMENT**<br\\\/><br\\\/>The Black interior maintains the Cobra's race-bred philosophy &ndash; everything you need, nothing you don't. This is a driver's car in its purest form, where man and machine communicate through steering feel, throttle response, and the symphony of American V8 power. The gasoline-fed engine delivers the intoxicating soundtrack and brutal acceleration that made the Cobra 427 a giant-killer in its era.<br\\\/><br\\\/>**INVESTMENT-GRADE RARITY**<br\\\/><br\\\/>As one of only two R-Specification examples produced in the CSX4000-Series, this Cobra represents an extraordinary opportunity for the serious collector. Its exclusivity, combined with the Shelby legacy and documented provenance, positions this vehicle as a centerpiece-worthy addition to any world-class collection.<br\\\/><br\\\/>Stock number CD2527 awaits its next custodian at Prestige Imports. This is your opportunity to own not just a Cobra, but THE Cobra &ndash; a piece of American performance history that will never be replicated.<br\\\/><br\\\/>Contact Prestige Imports today to arrange a private viewing of this exceptional automobile. Sales Price includes dealer fee of $1447.50 and $299 electronic filing fee. Tax, tag, title and registrations fees are not included and are calculated at time of purchase.\",\"isOEMCertified\":0,\"isDealerCertified\":0,\"body\":\"\",\"standardBody\":null,\"bodyStyle\":\"\",\"epaHighway\":null,\"epaCity\":null,\"drivetrain\":\"\",\"hasWarranty\":0,\"isSold\":0,\"dealerId\":7006,\"dealerCity\":\"North Miami Beach\",\"dealerState\":\"FL\",\"location\":\"North Miami Beach, FL\",\"dealerName\":\"Lamborghini Miami\",\"seoUrl\":\"vehicle-details\\\/used-1965-shelby-cobra-427-r-1-of-2-r-specification-csx4000-series-north-miami-beach-fl-id-65669926\",\"mainImageUrl\":\"\\\/\\\/cdn-ds.com\\\/stock\\\/1965-Shelby-Cobra-427-R-1-of-2-R-Specification-CSX4000-Series-North-Miami-Beach-FL\\\/seo\\\/ICC80512-000000000CSX4007R\\\/sz_112109\\\/b38fda0f5fe2ab2107d80e441945ec59.jpg\",\"photoCount\":40,\"series\":\"\",\"xSeries\":\"\",\"seriesCode\":\"\",\"cab\":\"\",\"bed\":\"\",\"videoCount\":0,\"comment1\":\"\",\"comment2\":\"\",\"comment3\":\"\",\"comment4\":\"\",\"comment5\":\"\",\"otherInfo\":{\"isVinDecodeEnabled\":true},\"dealerComment\":\"\",\"videos\":[],\"images\":{},\"viewCount\":0,\"carfaxReport\":null,\"isInTransit\":0,\"certifiedInspectionUrl\":null,\"standardizedExteriorColor\":\"Blue\",\"standardizedBody\":\"Unspecified\\\/Other\",\"standardizedDrivetrain\":\"Unspecified\\\/Other\",\"standardizedEngineDisplacement\":\"Unspecified\\\/O