,\"modelCode\":34242,\"trim\":\".\",\"styleDescription\":\"\",\"styleId\":419558,\"doorsNumber\":\"2\",\"vin\":\"SCAXZ8C08MU208437\",\"MSRP\":0,\"invoiceAmount\":0,\"blueBook\":0,\"sellingPrice\":329950,\"internetPrice\":0,\"originalPrice\":329950,\"miscPrice1\":0,\"miscPrice2\":0,\"miscPrice3\":0,\"NADARetailPrice\":0,\"mileage\":17938,\"transmission\":\"automatic\",\"transmissionDescription\":\"\",\"transmissionSpeedNumber\":\"\",\"engineCylindersNumber\":\"12\",\"engineDisplacement\":\"6.6\",\"engineDescription\":\"\",\"engineAspirationType\":\"\",\"engineBlockType\":\"\",\"interiorColor\":\"Mandarin\",\"interiorColorCode\":\"\",\"interiorColorHex\":null,\"interiorColorIcon\":null,\"upholstery\":\"\",\"interiorColorGeneric\":null,\"exteriorColor\":\"Arctic White\",\"exteriorColorCode\":\"F2F6F9\",\"exteriorColorHex\":null,\"exteriorColorIcon\":null,\"exteriorColorGeneric\":null,\"fuelType\":\"\",\"wheelbaseCode\":\"\",\"vehicleId\":147615918,\"isSpecial\":0,\"specialDisclaimer\":\"\",\"daysInStock\":29,\"dateInStock\":{\"date\":\"2026-09-01 00:00:00.000000\",\"timezone_type\":3,\"timezone\":\"UTC\"},\"description\":\"Prestige Imports is delighted to offer this 2021 Rolls-Royce Dawn for sale! <br\\\/><br\\\/>Powered by a twin-turbocharged 6.6L V12 producing 563 horsepower and 605 lb-ft of torque, the Dawn delivers effortless performance with a 0&ndash;60 mph time of approximately 4.8 seconds. Its rear-wheel-drive platform, adaptive air suspension, and sophisticated chassis technology provide a remarkably composed driving experience while maintaining the exceptional refinement expected from Rolls-Royce. The Dawn's elegant proportions, signature Pantheon grille, Spirit of Ecstasy hood ornament, and sleek convertible silhouette create an unmistakable presence, while the power-operated soft top transforms the grand tourer into an open-air experience. Inside, the cabin showcases exquisite materials, hand-finished craftsmanship, and advanced technology, with luxurious seating designed to make every journey exceptionally comfortable. Combining the exclusivity of Rolls-Royce with the freedom of open-air driving and effortless V12 performance, the Dawn is an extraordinary grand touring convertible for those who appreciate uncompromising luxury. <br\\\/><br\\\/>Contact Prestige Imports to make this Rolls-Royce Dawn yours today. Sales Price includes dealer fee of $1447.50 and $299 electronic filing fee. Tax, tag, title and registrations fees are not included and are calculated at time of purchase.\",\"isOEMCertified\":0,\"isDealerCertified\":0,\"body\":\"\",\"standardBody\":null,\"bodyStyle\":\"\",\"epaHighway\":18,\"epaCity\":12,\"drivetrain\":\"Rear Wheel Drive\",\"hasWarranty\":0,\"isSold\":0,\"dealerId\":7006,\"dealerCity\":\"North Miami Beach\",\"dealerState\":\"FL\",\"location\":\"North Miami Beach, FL\",\"dealerName\":\"Lamborghini Miami\",\"seoUrl\":\"vehicle-details\\\/used-2021-rolls-royce-dawn---north-miami-beach-fl-id-66070950\",\"mainImageUrl\":\"\\\/\\\/cdn-ds.com\\\/stock\\\/2021-Rolls-Royce-Dawn---North-Miami-Beach-FL\\\/seo\\\/ICC80512-SCAXZ8C08MU208437\\\/sz_103827\\\/3994cda7cc9907a209a6a60ca20a221e.jpg\",\"photoCount\":52,\"series\":\"\",\"xSeries\":\"\",\"seriesCode\":\"\",\"cab\":\"\",\"bed\":\"\",\"videoCount\":0,\"comment1\":\"Backup Camera,Brake Assist,Convertible,Heated Seats,Keyless Entry,Keyless Start,Leather Seats,Memory Seat,Navigation System,Stability Control,Traction Control,Turbocharged,USB Port\",\"comment2\":\"\",\"comment3\":\"\",\"comment4\":\"\",\"comment5\":\"\",\"otherInfo\":{\"isVinDecodeEnabled\":true},\"dealerComment\":\"\",\"videos\":[],\"images\":{},\"viewCount\":0,\"carfaxReport\":{\"image\":\"https:\\\/\\\/partnerstatic.carfax.com\\\/img\\\/valuebadge\\\/1own.svg\",\"link\":\"https:\\\/\\\/www.carfax.com\\\/vehiclehistory\\\/ar20\\\/2SNuO-vT4niNjgc_JbZabPbMmEwRNrSlh4SUDmS5FGYIG7byvJGL-NbjQN6jxlwqu00vPSrYNG1IyELLsLxymzL0P7o7vQIfGKE\",\"isOneOwner\":true},\"isInTransit\":0,\"certifiedInspectionUrl\":null,\"standardizedExteriorColor\":\"White\",\"standardizedBody\":\"Unspecified\\\/Other\",\"standardizedDrivetrain\":\"Rear-Wheel Drive\",\"standardizedEngineDisplacement\":\"6.6\",\"standardizedEngineCylinders\":\"Unspecified\\\/Other\",\"standardizedTransmission\":\"Automatic\",\"standardizedFuelType\":\"Unspecified\\\/Other\",\"standardizedInteriorColor\":\"Unspecified\\\/Other\",\"standardizedInteriorUpholstery\":\"Unspecified\\\/Other\",\"upperLevelPackageCode\":null,\"packagesAndAccessories\":[],\"certificationProgram\":\"\",\"title\":\"2021 Rolls-Royce Dawn .\",\"status\":\"in stock\",\"rebateAmount\":0,\"isReserved\":0,\"isCourtesy\":0,\"statusCode\":null,\"disclaimers\":[],\"isPooled\":0,\"cpo_validated\":null,\"vdp\":\"https:\\\/\\\/www.lamborghinimiami.com\\\/vehicle-details\\\/used-2021-rolls-royce-dawn---north-miami-beach-fl-id-66070950\",\"srp\":\"https:\\\/\\\/www.lamborghinimiami.com\\\/used-2021-rolls-royce-dawn-miami-fl\"}); });<\/script>\n<script>window.inlineJS.push(function() { Moff.modules.get('DataLayer').pushData('VehicleObject_66310172', {\"vuid\":66310172,\"stockNumber\":\"86113Y\",\"year\":2016,\"isNew\":false,\"finalPrice\":0,\"make\":\"Rolls-Royce\",\"model\":\"Dawn\",\"modelNumber\":\"\",\"modelCode\":29770,\"trim\":\"2dr Convertible\",\"styleDescription\":\"\",\"styleId\":387600,\"doorsNumber\":\"2\",\"vin\":\"SCA666D51GU102094\",\"MSRP\":0,\"invoiceAmount\":0,\"blueBook\":0,\"sellingPrice\":0,\"internetPrice\":0,\"originalPrice\":0,\"miscPrice1\":0,\"miscPrice2\":0,\"miscPrice3\":0,\"NADARetailPrice\":0,\"mileage\":14630,\"transmission\":\"automatic\",\"transmissionDescription\":\"\",\"transmissionSpeedNumber\":\"\",\"engineCylindersNumber\":\"12\",\"engineDisplacement\":\"6.6\",\"engineDescription\":\"\",\"engineAspirationType\":\"\",\"engineBlockType\":\"\",\"interiorColor\":\"Arctic White\",\"interiorColorCode\":\"\",\"interiorColorHex\":null,\"interiorColorIcon\":null,\"upholstery\":\"\",\"interiorColorGeneric\":null,\"exteriorColor\":\"Andalusian White\",\"exteriorColorCode\":\"F2F6F9\",\"exteriorColorHex\":null,\"exteriorColorIcon\":null,\"exteriorColorGeneric\":null,\"fuelType\":\"\",\"wheelbaseCode\":\"\",\"vehicleId\":147974802,\"isSpecial\":0,\"specialDisclaimer\":\"\",\"daysInStock\":7,\"dateInStock\":{\"date\":\"2026-09-23 00:00:00.000000\",\"timezone_type\":3,\"timezone\":\"UTC\"},\"description\":\"\\\"**2016 Rolls-Royce Dawn &ndash; Where Timeless Elegance Meets Open-Air Exhilaration**<br\\\/><br\\\/>Prestige Imports is honored to present this exceptional 2016 Rolls-Royce Dawn, a masterpiece of British automotive artistry finished in the stunning Andalusian White exterior. With only 14,630 carefully driven miles, this ultra-luxury convertible represents the pinnacle of open-top motoring refinement.<br\\\/><br\\\/>**Exquisite Design & Craftsmanship**<br\\\/><br\\\/>This Dawn showcases a breathtaking color combination featuring Andalusian White paintwork complemented by an Arctic White leather interior with full natural grain leather seat trim. The bespoke two-tone Red\\\/Seashell leather steering wheel adds a distinctive sporting touch, while the Black Cashmere headlining creates an intimate, sophisticated cabin atmosphere. Tuscan Ash Burr veneer adorns the interior surfaces, exemplifying Rolls-Royce's commitment to using only the finest materials. The Andalusian White contrast bonnet color provides an elegant visual accent that enhances the Dawn's commanding presence.<br\\\/><br\\\/>**Performance & Engineering Excellence**<br\\\/><br\\\/>Beneath the iconic Spirit of Ecstasy lies a magnificent 6.6-liter twin-turbocharged V12 engine, delivering effortless power through an 8-speed automatic transmission. The rear-wheel-drive configuration, combined with adaptive air suspension and automatic leveling, ensures the legendary \\\"\\\"magic carpet ride\\\"\\\" Rolls-Royce is renowned for. Twenty-inch seven-spoke cast alloy wheels complete the sophisticated aesthetic.<br\\\/><br\\\/>**Luxury Amenities**<br\\\/><br\\\/>This Dawn pampers occupants with heated and cooled front bucket seats featuring 12-way power adjustment and lumbar support. The Rolls-Royce Bespoke Audio system features 18 speakers and 1,300 watts of pure acoustic perfection. Dual-zone climate control, integrated navigation, and a comprehensive camera system ensure every journey is executed with precision and comfort.<br\\\/><br\\\/>**Safety & Technology**<br\\\/><br\\\/>Advanced safety features include front and rear parking sensors, backup camera, electronic stability control, and multiple airbags throughout the cabin.<br\\\/><br\\\/>**Stock #86113Y \\\/ VIN: SCA666D51GU102094**<br\\\/><br\\\/>Experience automotive royalty at Prestige Imports. This is more than transportation&mdash;it's a statement of uncompromising taste and achievement. Sales Price includes dealer fee of $1447.50 and $299 electronic filing fee. Tax, tag, title and registrations fees are not included and are calculated at time of purchase.\\\"\",\"isOEMCertified\":0,\"isDealerCertified\":0,\"body\":\"\",\"standardBody\":null,\"bodyStyle\":\"\",\"epaHighway\":19,\"epaCity\":12,\"drivetrain\":\"Rear Wheel Drive\",\"hasWarranty\":0,\"isSold\":0,\"dealerId\":7006,\"dealerCity\":\"North Miami Beach\",\"dealerState\":\"FL\",\"location\":\"North Miami Beach, FL\",\"dealerName\":\"Lamborghini Miami\",\"seoUrl\":\"vehicle-details\\\/used-2016-rolls-royce-dawn-2dr-convertible-north-miami-beach-fl-id-66310172\",\"mainImageUrl\":null,\"photoCount\":0,\"series\":\"\",\"xSeries\":\"\",\"seriesCode\":\"\",\"cab\":\"\",\"bed\":\"\",\"videoCount\":0,\"comment1\":\"Backup Camera,Brake Assist,Convertible,Heated Seats,Keyless Entry,Leather Seats,Memory Seat,Navigation System,Premium Sound System,Stability Control,Traction Control,Turbocharged\",\"comment2\":\"\",\"comment3\":\"\",\"comment4\":\"\",\"comment5\":\"\",\"otherInfo\":{\"isVinDecodeEnabled\":true},\"dealerComment\":\"\",\"videos\":[],\"images\":{},\"viewCount\":0,\"