', {\"vuid\":65769445,\"stockNumber\":\"85991Z\",\"year\":2020,\"isNew\":false,\"finalPrice\":210697,\"make\":\"Lamborghini\",\"model\":\"Urus\",\"modelNumber\":\"-URUS\",\"modelCode\":33157,\"trim\":\".\",\"styleDescription\":\"\",\"styleId\":412058,\"doorsNumber\":\"4\",\"vin\":\"ZPBUA1ZL6LLA06169\",\"MSRP\":0,\"invoiceAmount\":0,\"blueBook\":0,\"sellingPrice\":208950,\"internetPrice\":0,\"originalPrice\":208950,\"miscPrice1\":0,\"miscPrice2\":0,\"miscPrice3\":0,\"NADARetailPrice\":0,\"mileage\":4872,\"transmission\":\"Automatic\",\"transmissionDescription\":\"\",\"transmissionSpeedNumber\":\"8\",\"engineCylindersNumber\":\"8\",\"engineDisplacement\":\"4.0\",\"engineDescription\":\"4L V-8 gasoline direct injection, DOHC, variable valve control, twin turbo, premium unleaded, engine with cylinder deactivation and 641HP\",\"engineAspirationType\":\"\",\"engineBlockType\":\"\",\"interiorColor\":\"Nero Ade\",\"interiorColorCode\":\"\",\"interiorColorHex\":null,\"interiorColorIcon\":null,\"upholstery\":\"Leather front seat upholstery\",\"interiorColorGeneric\":null,\"exteriorColor\":\"Blu Astraeus Metallic\",\"exteriorColorCode\":\"172356\",\"exteriorColorHex\":null,\"exteriorColorIcon\":null,\"exteriorColorGeneric\":null,\"fuelType\":\"\",\"wheelbaseCode\":\"118.2\",\"vehicleId\":147172640,\"isSpecial\":0,\"specialDisclaimer\":\"\",\"daysInStock\":55,\"dateInStock\":{\"date\":\"2026-08-06 00:00:00.000000\",\"timezone_type\":3,\"timezone\":\"UTC\"},\"description\":\"Prestige Imports \\\/ Lamborghini Miami is delighted to offer this 2020 Lamborghini Urus for sale! <br\\\/><br\\\/>Combining the unmistakable design and performance DNA of Lamborghini with the versatility of a luxury SUV, the Urus delivers an extraordinary driving experience without sacrificing everyday practicality. Powered by a 4.0L twin-turbocharged V8 producing 641 horsepower and 627 lb-ft of torque, the Urus sends power through an 8-speed automatic transmission and permanent all-wheel-drive system, accelerating from 0&ndash;60 mph in approximately 3.5 seconds and reaching a top speed of 190 mph. Its aggressive proportions, sculpted bodywork, signature Y-shaped lighting, massive air intakes, and unmistakable Lamborghini styling create a commanding presence whether cruising through the city, arriving at an exclusive destination, or heading out for a spirited drive. Inside, the driver-focused cabin combines premium Italian craftsmanship with leather and Alcantara appointments, advanced technology, and Lamborghini's distinctive aerospace-inspired design, creating an environment that blends luxury with performance. With multiple ANIMA drive modes, adaptive air suspension, all-wheel steering, and standard carbon-ceramic brakes, the Urus offers remarkable versatility and confidence across a wide range of driving environments. For enthusiasts seeking the excitement and presence of a Lamborghini with the comfort, space, and usability of an SUV, the 2020 Urus remains an exceptional choice. <br\\\/><br\\\/>Contact Prestige Imports \\\/ Lamborghini Miami to make this Urus yours today. Sales Price includes dealer fee of $1447.50 and $299 electronic filing fee. Tax, tag, title and registrations fees are not included and are calculated at time of purchase.\",\"isOEMCertified\":0,\"isDealerCertified\":0,\"body\":\"Sport Utility\",\"standardBody\":null,\"bodyStyle\":\"Sport Utility\",\"epaHighway\":17,\"epaCity\":12,\"drivetrain\":\"All Wheel Drive\",\"hasWarranty\":0,\"isSold\":0,\"dealerId\":7006,\"dealerCity\":\"North Miami Beach\",\"dealerState\":\"FL\",\"location\":\"North Miami Beach, FL\",\"dealerName\":\"Lamborghini Miami\",\"seoUrl\":\"vehicle-details\\\/used-2020-lamborghini-urus---north-miami-beach-fl-id-65769445\",\"mainImageUrl\":\"\\\/\\\/cdn-ds.com\\\/stock\\\/2020-Lamborghini-Urus---North-Miami-Beach-FL\\\/seo\\\/ICC80512-ZPBUA1ZL6LLA06169\\\/sz_109939\\\/7a0061be7ee0155b426581315dcc573d.jpg\",\"photoCount\":56,\"series\":\"\",\"xSeries\":\"\",\"seriesCode\":\"\",\