176', {\"vuid\":64779176,\"stockNumber\":\"8324\",\"year\":2026,\"isNew\":true,\"finalPrice\":121649,\"make\":\"Lotus\",\"model\":\"Emira\",\"modelNumber\":\"EMIRA26V6SE\",\"modelCode\":74402,\"trim\":\"V6 SE Coupe\",\"styleDescription\":\"\",\"styleId\":482110,\"doorsNumber\":\"2\",\"vin\":\"SCCLEJAXXTHA10736\",\"MSRP\":121350,\"invoiceAmount\":0,\"blueBook\":0,\"sellingPrice\":121350,\"internetPrice\":0,\"originalPrice\":121350,\"miscPrice1\":0,\"miscPrice2\":0,\"miscPrice3\":0,\"NADARetailPrice\":0,\"mileage\":7,\"transmission\":\"Manual\",\"transmissionDescription\":\"\",\"transmissionSpeedNumber\":\"6\",\"engineCylindersNumber\":\"6\",\"engineDisplacement\":\"3.5\",\"engineDescription\":\"3.5L V-6 DOHC, variable valve control, intercooled supercharger, premium unleaded, engine with 400HP\",\"engineAspirationType\":\"\",\"engineBlockType\":\"\",\"interiorColor\":\"\",\"interiorColorCode\":\"\",\"interiorColorHex\":null,\"interiorColorIcon\":null,\"upholstery\":\"Simulated suede front seat upholstery\",\"interiorColorGeneric\":null,\"exteriorColor\":\"Dark Verdant\",\"exteriorColorCode\":\"36454F\",\"exteriorColorHex\":null,\"exteriorColorIcon\":null,\"exteriorColorGeneric\":null,\"fuelType\":\"\",\"wheelbaseCode\":\"101.4\",\"vehicleId\":145706787,\"isSpecial\":0,\"specialDisclaimer\":\"\",\"daysInStock\":170,\"dateInStock\":{\"date\":\"2026-04-13 00:00:00.000000\",\"timezone_type\":3,\"timezone\":\"UTC\"},\"description\":\"\\\"**Prestige Imports Presents: The 2026 Lotus Emira - Pure Driving Nirvana**<br\\\/><br\\\/>**Stock #8324 \\\/ VIN: SCCLEJAXXTHA10736**<br\\\/><br\\\/>Prepare to experience automotive artistry at its most exhilarating. This virtually untouched 2026 Lotus Emira, with a mere 7 miles on the odometer, represents the pinnacle of British sports-car engineering, wrapped in the stunning Dark Verdant exterior&mdash;a sophisticated deep green that captures the essence of Lotus's racing heritage.<br\\\/><br\\\/>**The Heart of a Champion**<br\\\/><br\\