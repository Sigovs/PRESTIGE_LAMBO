    "considered": 6,
    "taken": [
      {
        "id": "semlerpremium-dk-showroom",
        "what": "Solves inventory-inside-a-premium-frame by giving familiar SRP elements better hierarchy and handing the photograph most of the card; here that means the Selezione card keeps odometer and price but loses its condition/dealer chips, since the group label already states New or Pre-owned."
      },
      {
        "id": "semlerpremium-dk",
        "what": "Its recorded weakness is a homepage that tries to hold every part of the business; here that means no specials, finance, reviews, marine or other-brand blocks, and each lower chapter is a different kind of mass (image chapter, spec rows, archive, data) rather than another offer."
      },
      {
        "id": "polestar-com-us",
        "what": "Recorded weakness: discounts and offers placed early turn aspiration transactional; here the first two chapters carry no price at all, and prices appear only inside the inventory cards where the buyer is already comparing."
      }
    ],
    "rejected": [
      {
        "id": "porsche-com-usa",
        "why": "Its model cards are rounded gradient-overlay tiles, a pattern the entry itself flags as generic; the range here is a typographic index because two of four models have no honest image."
      },
      {
        "id": "mclaren-com-cars-gl-en",
        "why": "Numbered hero carousel with several campaign worlds; its own weakness is fragmentation at the top, and this page has one governing event, not a carousel."
      },
      {
        "id": "rolls-roycemotorcars-com-en-us-home-html",
        "why": "Frosted glass and circular buttons are Rolls-Royce's language; Lamborghini's observed system is square-cornered, opaque and condensed, so nothing transfers at the surface level."
      }
    ]
  }
}